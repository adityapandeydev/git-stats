# Server port (default: 8080)
PORT=8080

# GitHub Personal Access Token (Optional, recommended for GraphQL and 5,000 req/hr rate limit)
# Generate one at: https://github.com/settings/tokens (classic token with 'repo' scope for private repos or public_repo)
GITHUB_TOKEN=

# Cache duration in minutes for user language statistics (default: 120 minutes)
CACHE_TTL_MINUTES=120
